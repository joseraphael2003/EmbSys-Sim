{
    "name": "test-slice",
    "timeoutMs": 90000,
    "steps": [
        {
            "name": "app boots under Mbed CE headers",
            "timeoutMs": 20000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:boot"
            }
        },
        {
            "name": "sleep_for(500ms) elapses within scheduler slack",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLEEP-ELAPSED:(4[5-9][0-9]|5[0-9][0-9]|6[0-4][0-9])"
            }
        },
        {
            "name": "led-on phase printed with the pin reading 1",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:led-on 1"
            }
        },
        {
            "name": "LED1 reads 1 during the led-on phase",
            "timeoutMs": 15000,
            "read": {
                "gpio": "LED1",
                "expect": 1
            }
        },
        {
            "name": "led-off phase printed with the pin reading 0",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:led-off 0"
            }
        },
        {
            "name": "LED1 reads 0 during the led-off phase",
            "timeoutMs": 15000,
            "read": {
                "gpio": "LED1",
                "expect": 0
            }
        },
        {
            "name": "second led-on phase printed with the pin reading 1",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:led-on2 1"
            }
        },
        {
            "name": "LED1 reads 1 during the second led-on phase",
            "timeoutMs": 15000,
            "read": {
                "gpio": "LED1",
                "expect": 1
            }
        },
        {
            "name": "TCP echo round-trip verified",
            "timeoutMs": 30000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:tcp-echo-verified T1-SLICE-ECHO"
            }
        },
        {
            "name": "closed-port connect surfaces an NSAPI error",
            "timeoutMs": 30000,
            "assert": {
                "type": "serial",
                "regex": "TCP-ERR:-30[0-9][0-9]"
            }
        },
        {
            "name": "runner keeps executing after the failed connect",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:fail-path-continued"
            }
        },
        {
            "name": "slice completed end-to-end",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "SLICE:done"
            }
        }
    ]
}