{
    "name": "pwmout",
    "timeoutMs": 30000,
    "steps": [
        {
            "name": "PwmOut sweep starts at 10% duty",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "regex": "LED is now 0\\.10"
            }
        },
        {
            "name": "the duty cycle the application sets reaches the PWM pin and keeps changing",
            "timeoutMs": 15000,
            "read": {
                "gpio": "p5",
                "samples": 8,
                "intervalMs": 250,
                "within": [0, 1024],
                "distinctAtLeast": 4
            }
        },
        {
            "name": "read-back reports a duty cycle the application can observe",
            "timeoutMs": 5000,
            "assert": {
                "type": "serial",
                "regex": "LED is now (0|1)\\.\\d\\d"
            }
        }
    ]
}
