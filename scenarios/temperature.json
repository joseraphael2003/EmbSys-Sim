{
    "name": "temperature",
    "timeoutMs": 60000,
    "steps": [
        {
            "name": "temperature demo boots with the Sht31 over I2C",
            "timeoutMs": 15000,
            "assert": {
                "type": "serial",
                "substring": "Set the temperature above 25 degrees to trigger the warning LED"
            }
        },
        {
            "name": "the warning LED stays off while the sensor reports 20.50 C",
            "timeoutMs": 5000,
            "read": {
                "gpio": "LED1",
                "expect": 0
            }
        },
        {
            "name": "raise the simulated sensor above 25 degrees on the SHT31 component",
            "timeoutMs": 5000,
            "action": {
                "component": "SHT31",
                "selector": ".thermometer",
                "interaction": "click"
            }
        },
        {
            "name": "the demo's threshold turns the warning LED on for the hotter reading",
            "timeoutMs": 20000,
            "read": {
                "gpio": "LED1",
                "samples": 15,
                "intervalMs": 400,
                "someExpect": 1
            }
        },
        {
            "name": "the warning LED stays on while the sensor stays above the threshold",
            "timeoutMs": 10000,
            "read": {
                "gpio": "LED1",
                "samples": 5,
                "intervalMs": 300,
                "expect": 1
            }
        }
    ]
}
